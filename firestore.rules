rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ynsmohit1412@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    // This document is provisioned by a trusted administrator, not by a user profile edit.
    function hasActiveCommunityMembership(communityId) {
      let membershipPath = /databases/$(database)/documents/community_memberships/$(request.auth.uid + "_" + communityId);
      return isSignedIn() && communityId is string && communityId.size() <= 64 &&
        exists(membershipPath) &&
        get(membershipPath).data.userId == request.auth.uid &&
        get(membershipPath).data.villageId == communityId &&
        get(membershipPath).data.status == 'active';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'communityId', 'role', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('communityId' in data) || (data.communityId is string && data.communityId.size() <= 64)) &&
        (!('role' in data) || (data.role in ['resident', 'ward_representative', 'water_volunteer', 'admin'])) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation for CommunityAction
    function isValidCommunityAction(data) {
      return data.keys().hasAll(['id', 'communityId', 'userId', 'userName', 'actionType', 'title', 'ward', 'status']) &&
        data.keys().hasOnly(['id', 'communityId', 'userId', 'userName', 'userEmail', 'actionType', 'title', 'description', 'ward', 'impactLiters', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.communityId is string && data.communityId.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() <= 100 &&
        data.actionType in ['recharge_pit_clearing', 'borewell_scheduling', 'rainwater_harvest_check', 'leak_repair', 'greywater_recycling', 'recharge_well_monitoring'] &&
        data.title is string && data.title.size() <= 150 &&
        data.ward is string && data.ward.size() <= 100 &&
        data.status in ['proposed', 'in_progress', 'completed'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256)) &&
        (!('impactLiters' in data) || (data.impactLiters is number)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation for WaterPledge
    function isValidWaterPledge(data) {
      return data.keys().hasAll(['id', 'communityId', 'userId', 'userName', 'pledgeType', 'targetLitersPerDay']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'pledgeType', 'targetLitersPerDay', 'communityId', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() <= 100 &&
        data.pledgeType in ['irrigation_timing', 'aerator_install', 'rain_storage', 'recharge_well_adoption'] &&
        data.targetLitersPerDay is number &&
        data.communityId is string && data.communityId.size() <= 64 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation for FieldObservation
    function isValidFieldObservation(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'observationType', 'location', 'severity', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'observationType', 'location', 'severity', 'notes', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() <= 100 &&
        data.observationType in ['recharge_blockage', 'unusual_extraction', 'water_overflow', 'sensor_check_needed'] &&
        data.location is string && data.location.size() <= 150 &&
        data.severity in ['low', 'medium', 'high'] &&
        data.status in ['open', 'investigating', 'resolved'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email;
      allow delete: if isAdmin();
    }

    // Community actions
    match /community_actions/{actionId} {
      allow get, list: if hasActiveCommunityMembership(resource.data.communityId);
      allow create: if isSignedIn() && hasActiveCommunityMembership(incoming().communityId) && isValidId(actionId) && isValidCommunityAction(incoming()) && incoming().id == actionId && incoming().userId == request.auth.uid;
      allow update: if hasActiveCommunityMembership(existing().communityId) &&
        incoming().communityId == existing().communityId && isValidCommunityAction(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (
          isAdmin() ||
          existing().userId == request.auth.uid ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['status']))
        );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Water pledges
    match /water_pledges/{pledgeId} {
      allow get, list: if hasActiveCommunityMembership(resource.data.communityId);
      allow create: if isSignedIn() && hasActiveCommunityMembership(incoming().communityId) && isValidId(pledgeId) && isValidWaterPledge(incoming()) && incoming().id == pledgeId && incoming().userId == request.auth.uid;
      allow update: if hasActiveCommunityMembership(existing().communityId) &&
        incoming().communityId == existing().communityId && isValidWaterPledge(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        existing().userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Field observations
    match /field_observations/{observationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(observationId) && isValidFieldObservation(incoming()) && incoming().id == observationId;
      allow update: if isSignedIn() && isValidFieldObservation(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        (
          isAdmin() ||
          existing().userId == request.auth.uid ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes']))
        );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Community memberships: Provisioned by trusted administrator only; never user-editable
    match /community_memberships/{membershipId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Only server admin SDK or trusted console admin can provision
    }

    // Prototype node telemetry: Read scoped to active community members; written only via backend admin SDK
    match /prototype_node_telemetry/{telemetryId} {
      allow get, list: if hasActiveCommunityMembership(resource.data.villageId);
      allow write: if false; // Ingested via backend POST /api/v1/telemetry
    }

    // Legacy telemetry (deprecated): Scoped to confirmed active community membership
    match /prototype_telemetry/{telemetryId} {
      allow get, list: if hasActiveCommunityMembership(resource.data.villageId);
      allow write: if false;
    }

    // Community aggregate GEM balances: Read scoped to confirmed community members; write only via backend admin SDK
    match /community_gem_balances/{villageId} {
      allow get: if hasActiveCommunityMembership(villageId);
      allow list: if false;
      allow write: if false; // Clients cannot award themselves GEMs
    }

    // GEM accrual audit ledger: Read scoped to confirmed community members; write only via backend admin SDK
    match /gem_accruals/{accrualId} {
      allow get, list: if hasActiveCommunityMembership(resource.data.villageId);
      allow write: if false; // Clients cannot create or alter accrual records
    }
  }
}

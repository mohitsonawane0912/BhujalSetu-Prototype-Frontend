# ==============================================================================
# BhujalSetu Environment Variables Template (.env.example)
# Copy this to .env.local for local execution: cp .env.example .env.local
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Backend Server Port
PORT=5001

# IoT ESP32 Prototype Device Authentication Key
# ESP32 must provide this key in: Authorization: Bearer <DEVICE_API_KEY>
DEVICE_API_KEY="replace-with-a-unique-random-secret-at-least-32-characters"
# Optional node-specific keys (recommended; otherwise the shared key above is used).
NODE_1_DEVICE_API_KEY="replace-with-a-different-random-secret-for-node-1"
NODE_2_DEVICE_API_KEY="replace-with-a-different-random-secret-for-node-2"

# Google Gemini API Key for Server-Side Groundwater AI Advisor
GEMINI_API_KEY="your_gemini_api_key_here"

# Firebase Admin Service Account Credentials (Server-side Firestore access)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Option A (Recommended): Place the downloaded JSON file in project root and specify path
FIREBASE_SERVICE_ACCOUNT_PATH="./service-account.json"
FIREBASE_PROJECT_ID="gen-lang-client-0038143503"

# Option B (Alternative): Specify email and private key directly in environment variables
# FIREBASE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Web App URL
APP_URL="http://localhost:3000"
